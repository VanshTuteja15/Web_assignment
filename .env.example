# Copy this file to .env.local and fill in values from your Supabase project.
# Dashboard: Project Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL                 Project URL (safe to expose in the browser)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY     Publishable / anon key (safe to expose; RLS protects data)
# NEXT_PUBLIC_SUPABASE_ANON_KEY            Optional alias for the same key
#
# Never put the service-role key in this file or in any client-side code.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
